{
  "dashboard": {
    "title": "IB-Assistant Overview (v2)",
    "uid": "ib-overview-v2",
    "tags": ["ib-assistant"],
    "theme": "light",
    "time": { "from": "now-6h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m"],
      "time_options": ["3h", "6h", "24h"]
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "Requests per Stage",
        "datasource": "Prometheus",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(ib_req_total[1m])",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries", 
        "title": "Stage Latency",
        "datasource": "Prometheus",
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ib_stage_latency_sec_bucket[5m]))",
            "legendFormat": "P50 {{stage}}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": false
}
