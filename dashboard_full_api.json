{
  "dashboard": {
    "title": "IB-Assistant Overview (v2 Full)",
    "uid": "ib-overview-v2-full",
    "tags": ["ib-assistant"],
    "theme": "light",
    "time": { "from": "now-6h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m"],
      "time_options": ["3h", "6h", "24h"]
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "Requests per Stage",
        "datasource": "Prometheus",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(ib_req_total[1m])",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 0,
              "gradientMode": "none",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "auto"
            },
            "unit": "rps"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Stage Latency",
        "datasource": "Prometheus",
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ib_stage_latency_sec_bucket[5m]))",
            "legendFormat": "P50 {{stage}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ib_stage_latency_sec_bucket[5m]))",
            "legendFormat": "P95 {{stage}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "auto"
            },
            "unit": "s"
          }
        }
      },
      {
        "type": "stat",
        "title": "Timeout GC",
        "datasource": "Prometheus", 
        "gridPos": { "h": 4, "w": 12, "x": 0, "y": 5 },
        "targets": [
          {
            "expr": "rate(ib_timeout_total{kind=\"gc\"}[5m]) or on() vector(0)",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "textSize": { "title": 14, "value": 18 }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.1 }
              ]
            },
            "unit": "rps"
          }
        }
      },
      {
        "type": "stat",
        "title": "Timeout Web",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 5 },
        "targets": [
          {
            "expr": "rate(ib_timeout_total{kind=\"websearch\"}[5m]) or on() vector(0)",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "textSize": { "title": 14, "value": 18 }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.1 }
              ]
            },
            "unit": "rps"
          }
        }
      },
      {
        "type": "heatmap",
        "title": "Critic Heatmap",
        "datasource": "Prometheus",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
        "targets": [
          {
            "expr": "rate(ib_critic_score_bucket[5m])",
            "refId": "A"
          }
        ],
        "options": {
          "calculate": false,
          "cellGap": 1,
          "cellValues": {},
          "color": {
            "exponent": 0.5,
            "fill": "dark-orange",
            "mode": "spectrum",
            "reverse": false,
            "scale": "exponential",
            "scheme": "Oranges",
            "steps": 64
          },
          "exemplars": { "color": "rgba(255,0,255,0.7)" },
          "filterValues": { "le": 1e-9 },
          "legend": { "show": false },
          "rowsFrame": { "layout": "auto" },
          "tooltip": { "show": true, "yHistogram": false },
          "yAxis": { "axisPlacement": "left" }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": { "legend": false, "tooltip": false, "vis": false },
              "scaleDistribution": { "type": "linear" }
            },
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "type": "stat",
        "title": "SQLite Rows",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 9 },
        "targets": [
          {
            "expr": "sqlite_table_rows{table=\"dialog_log\"}",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "textSize": { "title": 14, "value": 18 }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          }
        }
      },
      {
        "type": "stat", 
        "title": "Qdrant Points",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 13 },
        "targets": [
          {
            "expr": "qdrant_collection_points{collection=~\".+\"}",
            "legendFormat": "{{collection}}",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name", 
          "textSize": { "title": 14, "value": 18 }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Status Throughput",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 12, "x": 0, "y": 15 },
        "targets": [
          {
            "expr": "rate(ib_status_bus_throughput_total[1m])",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineInterpolation": "linear", 
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "auto"
            },
            "unit": "rps"
          }
        }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 38
  },
  "overwrite": true
}
